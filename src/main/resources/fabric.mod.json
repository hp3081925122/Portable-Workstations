  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["com.portable_workstations.Portable_workstations"],
    "client": ["com.portable_workstations.client.PortableWorkstationsClient"]
  },
  "mixins": ["portable_workstations.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
